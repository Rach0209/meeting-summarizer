# .env.example — 이 파일을 복사해서 .env 로 저장 후 키 입력
# cp .env.example .env  (Mac/Linux)
# copy .env.example .env  (Windows)

# Groq API 키 (console.groq.com 에서 무료 발급)
GROQ_API_KEY=your_groq_api_key_here

# 사용할 Ollama 모델 (ollama list 로 설치된 모델 확인)
OLLAMA_MODEL=llama3.2

# AI 백엔드 기본값: ollama 또는 groq
DEFAULT_BACKEND=ollama
